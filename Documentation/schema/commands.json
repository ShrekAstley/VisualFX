{
  "ApplyPreset": {
    "Description": "Apply a preset (replaces the scene unless Merge = true).",
    "Fields": {
      "Name": {
        "Description": "preset name",
        "Kind": "string",
        "Required": true
      },
      "DryRun": {
        "Description": "only report what would change",
        "Kind": "boolean",
        "Required": false
      },
      "Duration": {
        "Description": "transition duration in seconds",
        "Kind": "number",
        "Required": false
      },
      "Easing": {
        "Description": "easing style",
        "Kind": "string",
        "Required": false
      },
      "Merge": {
        "Description": "merge into the current scene",
        "Kind": "boolean",
        "Required": false
      },
      "Overrides": {
        "Description": "configuration merged on top of the preset",
        "Kind": "table",
        "Required": false
      }
    },
    "Mutating": true
  },
  "Batch": {
    "Description": "Run several commands in order. Atomic (default true) reverts everything if any command fails.",
    "Fields": {
      "Atomic": {
        "Description": "revert all on failure (default true)",
        "Kind": "boolean",
        "Required": false
      },
      "Commands": {
        "Description": "array of commands",
        "Kind": "table",
        "Required": true
      }
    },
    "Mutating": true
  },
  "CommitPreview": {
    "Description": "Keep the current preview.",
    "Fields": {},
    "Mutating": false
  },
