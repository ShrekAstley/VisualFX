return function(t)
	local expect = t.expect

	t.describe("Quality and performance", function()
		t.it("scales particle rates by quality level", function()
			local engine = t.newEngine()
			engine:CreateParticleSystem("Dust", { Template = "Dust", Rate = 100 })
			local emitter = engine.InstanceManager:Find("particles.Dust")
			expect(emitter.Rate).toBeCloseTo(100)
			engine:SetQuality("Low")
			expect(emitter.Rate).toBeCloseTo(30)
			engine:SetQuality("Medium")
			expect(emitter.Rate).toBeCloseTo(60)
		end)

		t.it("caps the total particle rate", function()
			local engine = t.newEngine()
			local result = engine:SetQuality("Custom", { MaxParticleRate = 500, ParticleRateScale = 1 })
			expect(result.Success).toBe(true)
			engine:CreateParticleSystem("A", { Template = "Dust", Rate = 600 })
			local b = engine:CreateParticleSystem("B", { Template = "Dust", Rate = 400 })
			local warned = false
			for _, warning in ipairs(b.Warnings) do
				if string.find(warning, "budget", 1, true) then
					warned = true
				end
			end
			expect(warned).toBe(true)
			local stats = engine:GetPerformanceStats()
			expect(stats.EstimatedParticleRate).toBeLessThan(501)
			expect(stats.BudgetScale).toBeCloseTo(0.5)
		end)

		t.it("disables the lowest priority systems beyond the system limit", function()
			local engine = t.newEngine()
			engine:SetQuality("Custom", { MaxParticleSystems = 2 })
			engine:CreateWeather("HeavyRain") -- rain has priority 10
			engine:CreateParticleSystem("Low1", { Template = "Dust", Priority = 1 })
			engine:CreateParticleSystem("Low2", { Template = "Dust", Priority = 2 })
			expect(engine.InstanceManager:Find("weather.rain.primary").Enabled).toBe(true)
			expect(engine.InstanceManager:Find("particles.Low2").Enabled).toBe(true)
			expect(engine.InstanceManager:Find("particles.Low1").Enabled).toBe(false)
			local stats = engine:GetPerformanceStats()
			expect(stats.QualityDisabledSystems).toContain("particles.Low1")
		end)

		t.it("gates post-processing by quality level", function()
			local engine = t.newEngine()
			engine:ApplyPreset("CinematicSunset")
			local bloom = engine.InstanceManager:Find("postprocessing.bloom")
			local sunRays = engine.InstanceManager:Find("postprocessing.sunrays")
			expect(bloom.Enabled).toBe(true)
			engine:SetQuality("Low")
			expect(bloom.Enabled).toBe(false)
			expect(sunRays.Enabled).toBe(false)
			engine:SetQuality("Ultra")
			expect(bloom.Enabled).toBe(true)
		end)

		t.it("rejects unknown quality levels with suggestions", function()
			local engine = t.newEngine()
			local result = engine:SetQuality("Hihg")
			expect(result.Success).toBe(false)
			expect(result.Errors[1]).toContain("High")
		end)

		t.it("reports performance statistics without FPS claims", function()
			local engine = t.newEngine()
			engine:ApplyPreset("Storm")
			local stats = engine:GetPerformanceStats()
			expect(stats.ActiveParticleSystems).toBeGreaterThan(0)
			expect(stats.EstimatedParticleRate).toBeGreaterThan(0)
			expect(stats.ManagedInstances).toBeGreaterThan(0)
			expect(stats.UpdateFrequency).toBe(30)
			expect(stats.Quality).toBe("High")
			expect(stats.FPS).toBeNil()
		end)

		t.it("stores quality in the configuration", function()
			local engine = t.newEngine()
			engine:SetQuality("Medium", { MaxParticleSystems = 5 })
			local config = engine:ExportConfiguration()
			expect(config.Quality.Level).toBe("Medium")
			expect(config.Quality.MaxParticleSystems).toBe(5)
			local other = t.newEngine()
			other:ImportConfiguration(config)
			expect(other:GetQuality().Profile.MaxParticleSystems).toBe(5)
		end)
	end)
end
